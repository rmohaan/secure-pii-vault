# Template only. Export these with your deployment tooling; do not commit credentials.
SPRING_PROFILES_ACTIVE=gcp
# Direct private TLS: use a CA file and host matching the server certificate.
ALLOYDB_JDBC_URL=jdbc:postgresql://ALLOYDB_HOST:5432/investors?sslmode=verify-full&sslrootcert=/etc/db-ca/server-ca.pem
ALLOYDB_DB_USER=investor_app
DB_PASSWORD_SECRET_VERSION=projects/PROJECT_ID/secrets/investor-db-password/versions/1
KMS_FIELD_KEY=projects/PROJECT_ID/locations/REGION/keyRings/investors/cryptoKeys/field-kek
KMS_ARCHIVE_KEY=projects/PROJECT_ID/locations/REGION/keyRings/investors/cryptoKeys/archive-kek
KMS_HMAC_VERSION=projects/PROJECT_ID/locations/REGION/keyRings/investors/cryptoKeys/blind-index/cryptoKeyVersions/1
JWT_ISSUER=https://YOUR_OIDC_ISSUER
JWT_AUDIENCE=investor-api

# Rewrap shared DEKs with the current KMS primary version at startup.
UPDATE_DEK_ON_BOOT=false
